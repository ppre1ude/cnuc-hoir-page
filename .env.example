# 실제 값은 .env 또는 비밀 저장소에만 둡니다.
POSTGRES_PASSWORD=
PORTAL_HTTP_PORT=

# Compose 없이 API를 직접 실행할 때 사용합니다. Supabase는 Session pooler의 JDBC 주소와 sslmode=require를 사용합니다.
DB_URL=
DB_USER=
DB_PASSWORD=
GOOGLE_CLIENT_ID=
TRUSTED_PROXY_CIDRS=
REQUIRE_TRUSTED_PROXY=

# Vercel 웹 프로젝트에서 API를 연결할 때만 설정합니다. 경로 없는 HTTPS 출처입니다.
CHOIR_API_ORIGIN=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# 최초 운영진 지정 명령에서만 일시적으로 사용합니다.
CHOIR_BOOTSTRAP_DB_PASSWORD=
